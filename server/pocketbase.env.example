# Sao chép file này tới /etc/pocketbase/pocketbase.env (chmod 600, chown pocketbase:pocketbase)
# KHÔNG commit file thật chứa bí mật lên Git.

# [TÔI CẦN ĐIỀN] OAuth 2.0 Web Client ID từ Google Cloud Console (bắt buộc để xác minh Google ID Token)
GOOGLE_WEB_CLIENT_ID=TÔI_CẦN_ĐIỀN.apps.googleusercontent.com

# [TÔI CẦN ĐIỀN] URL công khai của server (HTTPS)
PB_PUBLIC_URL=https://api.tenmiencuatoi.vn

# [TÔI CẦN ĐIỀN] Chuỗi ngẫu nhiên 32 ký tự để PocketBase mã hóa cài đặt nhạy cảm trong DB (tạo bằng: openssl rand -hex 16)
PB_ENCRYPTION_KEY=TOI_CAN_DIEN_32_KY_TU_NGAU_NHIEN
