# Sao chép file này tới /etc/pocketbase/push.env
# chmod 600, chown pocketbase:pocketbase
# KHÔNG commit file thật chứa bí mật lên Git.

# URL công khai của PocketBase (HTTPS)
PB_URL=https://api.tenmiencuatoi.vn

# Tài khoản admin PocketBase (dùng để đọc push_outbox và xóa token chết).
# Có thể thay bằng PB_ADMIN_TOKEN nếu bạn dùng token admin có sẵn.
PB_ADMIN_EMAIL=[TÔI CẦN ĐIỀN: admin@tenmiencuatoi.vn]
PB_ADMIN_PASSWORD=[TÔI CẦN ĐIỀN: mật khẩu admin PocketBase]

# Đường dẫn service account JSON tải từ Firebase Console.
# Bắt buộc nằm ngoài repo và chmod 600.
FCM_SERVICE_ACCOUNT_FILE=/etc/pocketbase/fcm-service-account.json

# Số thông báo tối đa mỗi lượt chạy và khoảng nghỉ giữa 2 lần gửi (ms).
MAX_PER_RUN=50
SEND_INTERVAL_MS=50
