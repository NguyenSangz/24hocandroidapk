<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bắt buộc dùng HTTPS cho toàn bộ kết nối mạng thực tế -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Chỉ cho phép localhost khi chạy kiểm thử debug với emulator cục bộ -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
